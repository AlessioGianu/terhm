#!/usr/bin/env bash
# terhm - turns natural language into shell commands with a local model (Qwen3.5-4B).
# Usage: terhm ask "text" | terhm fix "command" | terhm danger "command" | terhm context | terhm doctor | terhm status | terhm ssh host
set -uo pipefail

TERHM_VERSION="0.3.0"
CONFIG_FILE="${TERHM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/terhm/config}"
# shellcheck disable=SC1090
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

: "${TERHM_HOST:=127.0.0.1}"
: "${TERHM_PORT:=11500}"
: "${TERHM_FILES:=40}"
: "${TERHM_RETRIES:=2}"          # extra attempts when the proposed command fails the check

# Model: Qwen3.5-4B. TERHM_THINK: auto (default) = answers right away, and reasons a
# little (up to TERHM_THINK_BUDGET tokens) only when the first answer was not good:
# alternative, fix of a failed command, command that fails the checks. short = always
# reasons a little; full = always reasons as long as it needs; off = never reasons.
# (The config or the environment can override every value.)
THINKING=0
[ "${TERHM_NO_THINK:-}" = 1 ] && : "${TERHM_THINK:=off}"
: "${TERHM_THINK:=auto}"; : "${TERHM_THINK_BUDGET:=256}"
: "${TERHM_REPEAT_PENALTY:=1.0}"; : "${TERHM_TOP_K:=20}"
# instruct mode: the model may answer in a ``` block, so stop at the end of the block
# or at a blank line rather than at the first newline
QWEN_STOP='["\n```", "\n\n"]'
case "$TERHM_THINK" in
  short|full)
    # reasons in a <think> block, then answers: room for the reasoning, more time,
    # the model card's thinking settings, no stop strings
    THINKING=1; TERHM_NO_THINK=0
    if [ "$TERHM_THINK" = short ]; then
      : "${TERHM_N_PREDICT:=$TERHM_THINK_BUDGET}"; : "${TERHM_TIMEOUT:=40}"
    else
      : "${TERHM_N_PREDICT:=1024}"; : "${TERHM_TIMEOUT:=60}"
    fi
    : "${TERHM_TOP_P:=0.95}"; STOP_JSON='[]' ;;
  *)
    [ "$TERHM_THINK" = auto ] || TERHM_THINK=off; TERHM_NO_THINK=1
    : "${TERHM_N_PREDICT:=160}"; : "${TERHM_TOP_P:=0.8}"; STOP_JSON=$QWEN_STOP ;;
esac
: "${TERHM_TIMEOUT:=20}"
: "${TERHM_TEMPERATURE:=0}"
: "${TERHM_PROJECT_CONTEXT:=1}"  # project type, build targets, scripts, services, ROS 2 workspace
: "${TERHM_TOOLS_CONTEXT:=1}"    # developer tools installed on the system

DEFAULT_DANGEROUS='(^|[;&|[:space:]])(sudo|su|doas|dd|mkfs[.a-z0-9]*|shred|wipefs|fdisk|parted)([[:space:]]|$)|rm[[:space:]]+(-[a-zA-Z]*[rf][a-zA-Z]*|--recursive|--force)|(chmod|chown)[[:space:]]+-[a-zA-Z]*R|>[[:space:]]*/dev/(sd|nvme|vd)|(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh|:\(\)[[:space:]]*\{'
: "${TERHM_DANGEROUS:=$DEFAULT_DANGEROUS}"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
TERHM_HOME="${TERHM_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/terhm}"
BASE_URL="http://${TERHM_HOST}:${TERHM_PORT}"

err() { printf 'terhm: %s\n' "$*" >&2; }

find_prompt() {
  local p
  for p in "$TERHM_HOME/prompts/system.txt" "$SELF_DIR/../prompts/system.txt"; do
    if [ -r "$p" ]; then printf '%s' "$p"; return 0; fi
  done
  return 1
}

# Listing for the context: directories first (with /), then files, hidden ones last,
# so in a home full of dotfiles the model still sees Downloads/, Documents/...
list_files() {
  local f dirs=() plain=() hidden=() out=()
  shopt -s nullglob
  for f in *; do if [ -d "$f" ]; then dirs+=("$f/"); else plain+=("$f"); fi; done
  for f in .[!.]* ..?*; do if [ -d "$f" ]; then hidden+=("$f/"); else hidden+=("$f"); fi; done
  for f in "${dirs[@]}" "${plain[@]}" "${hidden[@]}"; do
    if [[ $f == *[[:space:]]* ]]; then f="'$f'"; fi
    out+=("$f")
    [ "${#out[@]}" -ge "$TERHM_FILES" ] && break
  done
  [ "${#out[@]}" -gt 0 ] && printf '%s ' "${out[@]}"
}

# --- project and session context ----------------------------------------
# Everything below only looks at file names and a few small build files (Makefile,
# package.json, compose file, package.xml, setup.py). No other file contents, no
# environment variable values except the names of the active environments.

# up to N words from stdin, joined by spaces
_words() { awk -v n="$1" 'NF && !seen[$0]++ { if (c++ < n) printf "%s%s", (c > 1 ? " " : ""), $0 }'; }

make_targets() { # Makefile
  grep -E '^[A-Za-z0-9_][A-Za-z0-9_./-]*[[:space:]]*:([^=]|$)' "$1" 2>/dev/null \
    | sed -E 's/[[:space:]]*:.*//' | grep -v '%' | _words 15
}

compose_services() { # services of a compose file (top-level keys under "services:")
  awk '
    /^services:[[:space:]]*$/ { in_s = 1; next }
    in_s && /^[^[:space:]#]/ { in_s = 0 }
    in_s && /^[[:space:]]+[A-Za-z0-9_.-]+:/ {
      ind = match($0, /[^[:space:]]/)
      if (!want) want = ind
      if (ind == want) { s = $0; sub(/^[[:space:]]+/, "", s); sub(/:.*/, "", s); print s }
    }' "$1" 2>/dev/null | _words 12
}

npm_scripts() { jq -r '.scripts // {} | keys[]' "$1" 2>/dev/null | _words 15; }

# "name build_type" of a ROS 2 package.xml
ros_pkg_info() {
  local name bt
  name=$(sed -n 's:.*<name>[[:space:]]*\([^<[:space:]]*\)[[:space:]]*</name>.*:\1:p' "$1" | head -n1)
  bt=$(sed -n 's:.*<build_type>[[:space:]]*\([^<[:space:]]*\)[[:space:]]*</build_type>.*:\1:p' "$1" | head -n1)
  [ -n "$name" ] && printf '%s %s' "$name" "${bt:-ament_cmake}"
}

# executables of a ROS 2 package: console_scripts of setup.py/setup.cfg (ament_python)
# or add_executable of CMakeLists.txt (ament_cmake)
ros_pkg_execs() {
  local d="$1"
  {
    [ -f "$d/setup.py" ] && grep -oE "['\"][[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=[[:space:]]*[A-Za-z0-9_.]+:[A-Za-z0-9_]+" "$d/setup.py" \
      | sed -E "s/^['\"][[:space:]]*//; s/[[:space:]]*=.*//"
    [ -f "$d/setup.cfg" ] && grep -oE '^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=[[:space:]]*[A-Za-z0-9_.]+:[A-Za-z0-9_]+' "$d/setup.cfg" \
      | sed -E 's/^[[:space:]]*//; s/[[:space:]]*=.*//'
    [ -f "$d/CMakeLists.txt" ] && grep -oE 'add_executable\([[:space:]]*[A-Za-z0-9_-]+' "$d/CMakeLists.txt" \
      | sed -E 's/add_executable\([[:space:]]*//'
  } 2>/dev/null | _words 8
}

ros_launch_files() { # launch files of a package or workspace, names only
  find "$1" -maxdepth "${2:-3}" \( -name build -o -name install -o -name log -o -name .git \) -prune -o \
    -type f \( -name '*.launch.py' -o -name '*.launch.xml' -o -name '*.launch.yaml' -o -name '*.launch' \) -print 2>/dev/null \
    | sed 's:.*/::' | _words 8
}

# Nearest ROS 2 (colcon) workspace: a directory with src/ that contains package.xml
# files, starting from the current directory and going up at most 6 levels.
ros_workspace() {
  local d="$PWD" i=0
  while [ "$i" -le 6 ] && [ -n "$d" ]; do
    if [ -d "$d/src" ] && [ -n "$(find "$d/src" -maxdepth 4 -name package.xml -print -quit 2>/dev/null)" ]; then
      printf '%s' "$d"; return 0
    fi
    [ "$d" = / ] && break
    [ "$d" = "$HOME" ] && break
    d=$(dirname "$d"); i=$((i + 1))
  done
  return 1
}

# where (relative to the current directory) a path is: "" for ., otherwise " in DIR"
_where() { [ "$1" = "$PWD" ] && return; printf ' in %s' "$(_rel "$1")"; }

# path relative to the current directory when it is a parent or a child, else with ~
_rel() {
  local r
  r=$(realpath -s --relative-to="$PWD" "$1" 2>/dev/null) || r=""
  case "$r" in ""|*[!./]*../*) printf '%s' "${1/#$HOME/\~}" ;; *) printf '%s' "$r" ;; esac
}

# One line per project type found in directory $1.
scan_project() {
  local d="$1" w f t pm venv
  w=$(_where "$d")
  for f in Makefile makefile GNUmakefile; do
    if [ -f "$d/$f" ]; then
      t=$(make_targets "$d/$f")
      printf 'make: %s%s%s\n' "$f" "$w" "${t:+, targets: $t}"; break
    fi
  done
  [ -f "$d/CMakeLists.txt" ] && [ ! -f "$d/package.xml" ] && \
    printf 'cmake: CMakeLists.txt%s%s\n' "$w" "$([ -d "$d/build" ] && printf ', build/ exists')"
  [ -f "$d/meson.build" ] && printf 'meson: meson.build%s\n' "$w"
  for f in justfile Justfile .justfile; do [ -f "$d/$f" ] && { printf 'just: %s%s\n' "$f" "$w"; break; }; done
  for f in Taskfile.yml Taskfile.yaml; do [ -f "$d/$f" ] && { printf 'task: %s%s\n' "$f" "$w"; break; }; done
  for f in compose.yaml compose.yml docker-compose.yml docker-compose.yaml; do
    if [ -f "$d/$f" ]; then
      t=$(compose_services "$d/$f")
      printf 'docker compose: %s%s%s\n' "$f" "$w" "${t:+, services: $t}"; break
    fi
  done
  t=$(cd "$d" 2>/dev/null && shopt -s nullglob && for f in Dockerfile Containerfile Dockerfile.* *.Dockerfile; do
        [ -f "$f" ] && printf '%s\n' "$f"; done | _words 5)
  [ -n "$t" ] && printf 'docker: %s%s\n' "$t" "$w"
  if [ -f "$d/package.json" ]; then
    pm=npm
    [ -f "$d/pnpm-lock.yaml" ] && pm=pnpm
    [ -f "$d/yarn.lock" ] && pm=yarn
    { [ -f "$d/bun.lockb" ] || [ -f "$d/bun.lock" ]; } && pm=bun
    t=$(npm_scripts "$d/package.json")
    printf 'node: package.json%s, package manager %s%s%s\n' "$w" "$pm" "${t:+, scripts: $t}" \
      "$([ -d "$d/node_modules" ] || printf ', node_modules/ missing (not installed)')"
  fi
  if [ -f "$d/pyproject.toml" ] || [ -f "$d/requirements.txt" ] || [ -f "$d/setup.py" ] || [ -f "$d/Pipfile" ]; then
    if [ ! -f "$d/package.xml" ]; then
      pm=pip
      [ -f "$d/Pipfile" ] && pm=pipenv
      [ -f "$d/poetry.lock" ] && pm=poetry
      [ -f "$d/uv.lock" ] && pm=uv
      t=$(cd "$d" && ls pyproject.toml requirements*.txt setup.py Pipfile 2>/dev/null | _words 4)
      venv=""
      for f in .venv venv env; do [ -f "$d/$f/bin/activate" ] && { venv="$f/"; break; }; done
      printf 'python: %s%s, tool %s%s%s\n' "$t" "$w" "$pm" "${venv:+, virtualenv $venv}" \
        "$([ -f "$d/manage.py" ] && printf ', django manage.py')"
    fi
  fi
  [ -f "$d/Cargo.toml" ] && printf 'rust: Cargo.toml%s (cargo)\n' "$w"
  [ -f "$d/go.mod" ] && printf 'go: go.mod%s\n' "$w"
  [ -f "$d/pom.xml" ] && printf 'java: pom.xml%s (maven%s)\n' "$w" "$([ -x "$d/mvnw" ] && printf ', ./mvnw')"
  { [ -f "$d/build.gradle" ] || [ -f "$d/build.gradle.kts" ]; } && printf 'java/kotlin: gradle%s%s\n' "$w" "$([ -x "$d/gradlew" ] && printf ', ./gradlew')"
  [ -f "$d/Gemfile" ] && printf 'ruby: Gemfile%s (bundler)\n' "$w"
  [ -f "$d/composer.json" ] && printf 'php: composer.json%s\n' "$w"
  [ -f "$d/Chart.yaml" ] && printf 'helm chart: Chart.yaml%s\n' "$w"
  [ -f "$d/kustomization.yaml" ] && printf 'kubernetes: kustomization.yaml%s\n' "$w"
  [ -n "$(find "$d" -maxdepth 1 -name '*.tf' -print -quit 2>/dev/null)" ] && printf 'terraform: *.tf%s\n' "$w"
  [ -f "$d/Vagrantfile" ] && printf 'vagrant: Vagrantfile%s\n' "$w"
  [ -f "$d/flake.nix" ] && printf 'nix: flake.nix%s\n' "$w"
  [ -f "$d/.devcontainer/devcontainer.json" ] && printf 'devcontainer: .devcontainer/%s\n' "$w"
  [ -f "$d/.env" ] && printf 'env file: .env%s (not read)\n' "$w"
  return 0
}

ros_context() {
  local ws pkg info execs launch pkgs="" f n built sourced
  # current directory (or a parent, up to the workspace) is a ROS 2 package
  pkg=""; f="$PWD"
  while [ -n "$f" ] && [ "$f" != / ] && [ "$f" != "$HOME" ]; do
    [ -f "$f/package.xml" ] && { pkg="$f"; break; }
    [ -d "$f/src" ] && break
    f=$(dirname "$f")
  done
  if [ -n "$pkg" ] && info=$(ros_pkg_info "$pkg/package.xml"); then
    execs=$(ros_pkg_execs "$pkg"); launch=$(ros_launch_files "$pkg" 3)
    printf 'ros2 package: %s (%s)%s%s%s\n' "${info% *}" "${info#* }" "$(_where "$pkg")" \
      "${execs:+, executables: $execs}" "${launch:+, launch files: $launch}"
  fi
  if ws=$(ros_workspace); then
    n=0
    while IFS= read -r f; do
      info=$(ros_pkg_info "$f") || continue
      execs=$(ros_pkg_execs "$(dirname "$f")")
      pkgs+="${pkgs:+; }${info% *} (${info#* }${execs:+: $execs})"
      n=$((n + 1)); [ "$n" -ge 12 ] && break
    done < <(find "$ws/src" -maxdepth 4 \( -name build -o -name install -o -name log -o -name .git \) -prune -o \
               -name package.xml -print 2>/dev/null | sort)
    built="not built yet (no install/)"
    [ -f "$ws/install/setup.bash" ] && built="built (install/setup.bash exists)"
    sourced="not sourced"
    case ":${AMENT_PREFIX_PATH:-}:${COLCON_PREFIX_PATH:-}:" in *":$ws/install"*) sourced="sourced" ;; esac
    printf 'ros2 workspace: %s, colcon, %s, %s%s\n' "$(_rel "$ws")" "$built" "$sourced" "${pkgs:+, packages: $pkgs}"
    launch=$(ros_launch_files "$ws/src" 5)
    [ -n "$launch" ] && printf 'ros2 launch files: %s\n' "$launch"
  fi
  return 0
}

# Project root: the git top level if inside a repo, otherwise the current directory.
project_context() {
  local root out
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  out=$(scan_project "$PWD")
  if [ -n "$root" ] && [ "$root" != "$PWD" ]; then out+=$'\n'$(scan_project "$root"); fi
  out+=$'\n'$(ros_context)
  printf '%s\n' "$out" | sed '/^$/d' | head -n 16
}

# Active environments and session type (names only).
session_context() {
  local env=() s
  [ -n "${VIRTUAL_ENV:-}" ] && env+=("python virtualenv active: ${VIRTUAL_ENV/#$HOME/\~}")
  [ -n "${CONDA_DEFAULT_ENV:-}" ] && env+=("conda env active: $CONDA_DEFAULT_ENV")
  [ -n "${ROS_DISTRO:-}" ] && env+=("ROS 2 $ROS_DISTRO sourced${ROS_DOMAIN_ID:+ (ROS_DOMAIN_ID=$ROS_DOMAIN_ID)}")
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then env+=("desktop: Wayland")
  elif [ -n "${DISPLAY:-}" ]; then env+=("desktop: X11")
  else env+=("no graphical display")
  fi
  [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ] && env+=("over SSH")
  { [ -f /.dockerenv ] || [ -f /run/.containerenv ]; } && env+=("inside a container")
  grep -qi microsoft /proc/version 2>/dev/null && env+=("WSL")
  [ -n "${TMUX:-}" ] && env+=("inside tmux")
  [ "$(id -u)" = 0 ] && env+=("running as root (no sudo needed)")
  [ "${#env[@]}" -gt 0 ] || return 0
  s=$(printf '%s; ' "${env[@]}"); printf 'session: %s\n' "${s%; }"
}

# Developer tools installed, so the model picks the ones that exist
# (docker compose vs docker-compose, wl-copy vs xclip, fd vs find...).
tools_context() {
  local t have=() d
  for t in docker podman docker-compose kubectl helm minikube make cmake ninja meson just gcc g++ clang \
           python3 pip pip3 uv poetry pipenv conda node npm pnpm yarn bun cargo go java mvn gradle \
           ros2 colcon rosdep gh glab rg fd fdfind fzf bat jq yq xclip xsel wl-copy tmux systemctl \
           snap flatpak nvim vim code; do
    command -v "$t" >/dev/null 2>&1 && have+=("$t")
  done
  if command -v docker >/dev/null 2>&1; then
    for d in "$HOME/.docker/cli-plugins" /usr/local/lib/docker/cli-plugins /usr/libexec/docker/cli-plugins \
             /usr/lib/docker/cli-plugins /usr/local/libexec/docker/cli-plugins; do
      [ -x "$d/docker-compose" ] && { have+=("docker-compose-v2(use 'docker compose')"); break; }
    done
    # docker without sudo: root, docker group, rootless socket or DOCKER_HOST
    if [ "$(id -u)" != 0 ] && [ -z "${DOCKER_HOST:-}" ] && [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock" ] \
       && ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
      have+=("(docker needs sudo: user not in docker group)")
    fi
  fi
  [ "${#have[@]}" -gt 0 ] && printf 'installed tools: %s\n' "${have[*]}"
}

git_context() {
  local branch n up
  branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || true)
  [ -n "$branch" ] || return 0
  n=$(git status --porcelain 2>/dev/null | head -n 500 | wc -l)
  up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  printf 'git branch: %s, %s changed files%s\n' "$branch" "$((n))" "${up:+, tracking $up}"
}

build_context() {
  local hist
  printf 'cwd: %s\n' "$PWD"
  if command -v git >/dev/null 2>&1; then git_context; fi
  if [ "$TERHM_PROJECT_CONTEXT" = 1 ]; then project_context; fi
  session_context
  if [ "$TERHM_TOOLS_CONTEXT" = 1 ]; then tools_context; fi
  if [ -n "${TERHM_LAST_STATUS:-}" ] && [ "$TERHM_LAST_STATUS" != "0" ]; then
    printf 'last exit code: %s\n' "$TERHM_LAST_STATUS"
  fi
  if [ -n "${TERHM_HISTORY:-}" ]; then
    hist="${TERHM_HISTORY//$'\n'/; }"
    printf 'recent commands: %s\n' "$hist"
  fi
  printf 'files: %s\n' "$(list_files)"
}

# Cleans the model output: no <think> block, the first line inside a ``` block if
# there is one (else the first non-empty line), no surrounding backticks or leading "$ ".
clean_output() {
  local s="$1" line found=0
  s="${s//$'\r'/}"
  # a thinking block (if the model or template still produced one)
  if [[ $s == *"</think>"* ]]; then s="${s##*</think>}"; fi
  s="${s#<think>}"
  # reasoning models explain around the command: keep what follows the opening fence
  if [[ $s == *$'\n```'* || $s == '```'* ]] && [[ ${s#*'```'} == *$'\n'* ]]; then
    s="${s#*'```'}"; s="${s#*$'\n'}"
  fi
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in ""|'```'*) continue ;; esac
    s="$line"; found=1; break
  done <<< "$s"
  [ "$found" = 1 ] || s=""   # only blank or fence lines
  while [[ $s == \`* ]]; do s="${s#\`}"; done
  while [[ $s == *\` ]]; do s="${s%\`}"; done
  s="${s#"${s%%[![:space:]]*}"}"
  case "$s" in '$ '*) s="${s#\$ }" ;; esac
  printf '%s' "$s"
}

# Checks the command WITHOUT running it: syntax (with the user's shell "-n") and
# programs that are not installed. Prints the problems found (empty = none).
check_command() {
  local cmd="$1" sh="${TERHM_SHELL:-bash}" seg w i problems="" msg
  local -a words
  case "$sh" in bash|zsh|fish|sh|dash|ksh) ;; *) sh=bash ;; esac
  command -v "$sh" >/dev/null 2>&1 || sh=bash
  if ! msg=$(printf '%s\n' "$cmd" | "$sh" -n 2>&1); then
    msg="${msg//$'\n'/ }"
    problems="syntax error (${msg:0:160}). "
  fi
  while IFS= read -r seg; do
    IFS=' ' read -r -a words <<< "$seg"
    i=0
    while [ "$i" -lt "${#words[@]}" ]; do
      case "${words[$i]}" in sudo|env|nohup|time|command|exec|-*|*=*|\(|\{|!) i=$((i + 1)) ;; *) break ;; esac
    done
    w="${words[$i]:-}"
    w="${w%%[\)\`]*}"
    case "$w" in ""|*[\$\`\'\"\(\)\{\}\[\]\<\>]*) continue ;; esac
    if ! command -v -- "$w" >/dev/null 2>&1 && ! [[ " ${TERHM_KNOWN:-} " == *" $w "* ]]; then
      problems="$problems'$w' is not installed. "
    fi
  done < <(printf '%s\n' "$cmd" | sed -E 's/\|\||&&|[|;]|\$\(|`/\n/g')
  printf '%s' "$problems"
}

# System prompt: fixed instructions (identical across requests, so the llama.cpp
# prompt cache holds) followed by the context of the current directory.
system_prompt() {
  local os="" pkg="" p h
  if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    os=$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-}")
  fi
  for p in apt dnf pacman zypper apk brew; do
    if command -v "$p" >/dev/null 2>&1; then pkg="$p"; break; fi
  done
  h=$(cat "$PROMPT_FILE")
  h="${h//\{\{OS\}\}/${os:-$(uname -s)}}"
  h="${h//\{\{ARCH\}\}/$(uname -m)}"
  h="${h//\{\{SHELL\}\}/${TERHM_SHELL:-${SHELL##*/}}}"
  h="${h//\{\{PKG\}\}/${pkg:-unknown}}"
  printf '%s\n\n%s' "$h" "$(build_context)"
}

# One request to the model. $1 = chat messages (JSON array, without the system
# prompt), $2 = temperature. Prints the cleaned command.
generate() {
  local msgs="$1" temp="$2" payload resp out
  payload=$(jq -n --arg sys "$(system_prompt)" --argjson m "$msgs" --argjson n "$TERHM_N_PREDICT" \
    --argjson t "$temp" --argjson rp "$TERHM_REPEAT_PENALTY" --argjson tk "$TERHM_TOP_K" \
    --argjson tp "$TERHM_TOP_P" --argjson stop "$STOP_JSON" --argjson nothink "$TERHM_NO_THINK" \
    --argjson thinking "$THINKING" \
    '{messages:([{role:"system", content:$sys}] + $m), max_tokens:$n,
      temperature:(if $thinking == 1 and $t < 0.6 then 0.6 else $t end),
      repeat_penalty:$rp, repeat_last_n:64, top_k:$tk, top_p:$tp, cache_prompt:true, stop:$stop}
     + (if $nothink == 1 then {chat_template_kwargs:{enable_thinking:false}} else {} end)') \
    || { err "jq not available or payload error"; return 2; }
  if ! resp=$(curl -sS --max-time "$TERHM_TIMEOUT" -H 'Content-Type: application/json' \
      -d "$payload" "$BASE_URL/v1/chat/completions" 2>&1); then
    err "server unreachable at $BASE_URL (run: terhm doctor)"
    return 1
  fi
  out=$(printf '%s' "$resp" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
  # out of tokens while still reasoning: what came back is not an answer
  # (llama-server puts the reasoning in reasoning_content, or leaves it in content)
  if [ "$THINKING" = 1 ] && [[ $out != *"</think>"* ]] && printf '%s' "$resp" | jq -e \
      '.choices[0].finish_reason == "length" and
       (((.choices[0].message.content // "") | test("^\\s*$")) or (.choices[0].message.reasoning_content // "") == "")' \
      >/dev/null 2>&1; then
    if [ "$TERHM_THINK" = short ]; then
      # reasoning budget used up: ask again with thinking off, giving the reasoning so
      # far as notes, so the answer still benefits from it
      local notes
      notes=$(printf '%s' "$resp" | jq -r '.choices[0].message.reasoning_content // empty')
      [ -n "$notes" ] || notes="${out#*<think>}"
      msgs=$(jq -c --arg n "$notes" \
        '.[-1].content += "\n\nYour notes so far (unfinished):\n" + $n + "\n\nNow reply with the command only."' <<< "$msgs")
      THINKING=0 TERHM_NO_THINK=1 TERHM_N_PREDICT=160 STOP_JSON=$QWEN_STOP generate "$msgs" "$temp"
      return
    fi
    err "the model ran out of tokens while reasoning (raise TERHM_N_PREDICT, now $TERHM_N_PREDICT)"
    return 1
  fi
  clean_output "$out"
}

# Runs "$@" with a short reasoning when TERHM_THINK=auto (the first answer was not
# good enough); otherwise as configured.
with_reasoning() {
  if [ "${TERHM_THINK:-}" = auto ]; then
    THINKING=1 TERHM_NO_THINK=0 TERHM_THINK=short TERHM_N_PREDICT=$TERHM_THINK_BUDGET \
      TERHM_TOP_P=0.95 STOP_JSON='[]' TERHM_TIMEOUT=$(( TERHM_TIMEOUT > 40 ? TERHM_TIMEOUT : 40 )) "$@"
  else
    "$@"
  fi
}

# Appends a turn to the conversation: $1 = messages, $2 = role, $3 = text.
add_msg() { jq -c --arg r "$2" --arg c "$3" '. + [{role:$r, content:$c}]' <<< "$1"; }

# Generate and check: if the command fails the checks, send the problems back to the
# model, up to TERHM_RETRIES times. Prints the first valid command (or the last one).
propose() { # messages, temperature
  local msgs="$1" temp="$2" out problems n=0
  out=$(generate "$msgs" "$temp") || return $?
  while [ -n "$out" ] && [ "${TERHM_CHECK:-1}" = "1" ] && [ "$n" -lt "$TERHM_RETRIES" ]; do
    problems=$(check_command "$out")
    [ -z "$problems" ] && break
    n=$((n + 1))
    msgs=$(add_msg "$msgs" assistant "$out")
    msgs=$(add_msg "$msgs" user "That command does not work here: ${problems}Reply with a different single command that works on this system.")
    out=$(with_reasoning generate "$msgs" "$temp") || return $?
  done
  if [ -z "$out" ]; then err "the model produced no command"; return 1; fi
  printf '%s\n' "$out"
}

cmd_ask() {
  local req="$*" msgs temp="$TERHM_TEMPERATURE"
  if [ -z "$req" ] && [ ! -t 0 ]; then req=$(cat); fi
  if [ -z "${req//[[:space:]]/}" ]; then err "empty request"; return 2; fi
  PROMPT_FILE=$(find_prompt) || { err "prompts/system.txt not found (TERHM_HOME=$TERHM_HOME)"; return 2; }
  msgs=$(add_msg '[]' user "$req")
  if [ "${TERHM_ALT:-0}" = "1" ]; then
    temp="0.7"
    # alternative: explicitly ask for a command different from the one already proposed
    if [ -n "${TERHM_PREV:-}" ]; then
      msgs=$(add_msg "$msgs" assistant "$TERHM_PREV")
      msgs=$(add_msg "$msgs" user "Give a different command for the same request.")
    fi
    with_reasoning propose "$msgs" "$temp"; return
  fi
  propose "$msgs" "$temp"
}

# Fix for a command that failed when it was run.
# terhm fix [--status N] [--request "original request"] [--] "command"
cmd_fix() {
  local st="" orig="" cmd msgs why out
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) st="${2:-}"; shift 2 ;;
      --request) orig="${2:-}"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  cmd="$*"
  if [ -z "${cmd//[[:space:]]/}" ]; then err "no command to fix"; return 2; fi
  PROMPT_FILE=$(find_prompt) || { err "prompts/system.txt not found (TERHM_HOME=$TERHM_HOME)"; return 2; }
  why="it failed"
  [ -n "$st" ] && why="it failed with exit code $st"
  case "$st" in
    127) why="$why (command not found)" ;;
    126) why="$why (permission denied or not executable)" ;;
  esac
  if [ -n "${TERHM_ERROR:-}" ]; then why="$why: ${TERHM_ERROR:0:300}"; fi
  if [ -n "$orig" ]; then
    msgs=$(add_msg '[]' user "$orig")
    msgs=$(add_msg "$msgs" assistant "$cmd")
    msgs=$(add_msg "$msgs" user "I ran it and $why. Reply with a corrected single command.")
  else
    msgs=$(add_msg '[]' user "Fix this command, $why: $cmd")
  fi
  out=$(with_reasoning propose "$msgs" "$TERHM_TEMPERATURE") || return $?
  # same command as before: ask for something different, with more randomness
  if [ "$out" = "$cmd" ]; then
    msgs=$(add_msg "$msgs" assistant "$out")
    msgs=$(add_msg "$msgs" user "That is the same command that failed. Give a different one.")
    out=$(with_reasoning propose "$msgs" 0.7) || return $?
  fi
  printf '%s\n' "$out"
}

# Prints the context that would be sent with a request from the current directory.
cmd_context() { build_context; }

cmd_danger() {
  printf '%s' "$1" | grep -Eq -- "$TERHM_DANGEROUS"
}

cmd_status() {
  curl -fsS --max-time 3 "$BASE_URL/health" >/dev/null 2>&1 || return 1
}

cmd_doctor() {
  local ok=0 c
  for c in curl jq grep; do
    if command -v "$c" >/dev/null 2>&1; then printf '[ok]   %s\n' "$c"; else printf '[FAIL] missing: %s\n' "$c"; ok=1; fi
  done
  printf '[info] model: Qwen3.5-4B, reasoning: %s\n' "$TERHM_THINK"
  # configs from older versions could select nl2sh-1.5b, which is no longer supported
  case "${TERHM_MODEL:-}" in
    ''|qwen*) ;;
    *) printf '[FAIL] the config selects the model "%s", no longer supported: rerun ./install.sh\n' "$TERHM_MODEL"; ok=1 ;;
  esac
  if find_prompt >/dev/null; then
    printf '[ok]   prompt: %s\n' "$(find_prompt)"
  else
    printf '[FAIL] prompts/system.txt not found\n'; ok=1
  fi
  if [ -n "${TERHM_SSH_PORT:-}" ]; then
    printf '[info] ssh session: the model runs on your local machine, reached through the tunnel\n'
  elif command -v systemctl >/dev/null 2>&1; then
    printf '[info] service: %s\n' "$(systemctl --user is-active terhm.service 2>&1)"
  fi
  if cmd_status; then
    printf '[ok]   server responding at %s\n' "$BASE_URL"
  else
    printf '[FAIL] server not responding at %s\n       try: systemctl --user status terhm ; journalctl --user -u terhm -e\n' "$BASE_URL"
    ok=1
  fi
  return $ok
}

# --- ssh sessions -----------------------------------------------------------
# "terhm ssh host" = ssh with Ctrl+G on the remote host. The model keeps running here:
# a reverse tunnel (ssh -R) lets the remote reach it, and a small bundle (this script,
# the prompt, the shell plugins) is sent inside the ssh command and unpacked in
# ~/.cache/terhm/ssh/ on the remote. Context (cwd, files, tools) comes from the remote.
# Needs bash, curl and jq on the remote; nothing is installed there permanently.

find_shell_dir() {
  local p
  for p in "$TERHM_HOME/shell" "$SELF_DIR/../shell"; do
    if [ -r "$p/terhm.bash" ]; then printf '%s' "$p"; return 0; fi
  done
  return 1
}

# Startup files that load the user's own config, then the plugin.
ssh_write_rcfiles() { # $1 = bundle directory
  local d="$1" f
  mkdir -p "$d/zsh"
  # bash: same files as a login shell (what plain ssh would run), then the plugin
  cat > "$d/bashrc" <<'EOF'
[ -f /etc/profile ] && . /etc/profile
if [ -f ~/.bash_profile ]; then . ~/.bash_profile
elif [ -f ~/.bash_login ]; then . ~/.bash_login
elif [ -f ~/.profile ]; then . ~/.profile
fi
PATH="$TERHM_HOME/bin:$PATH"
. "$TERHM_HOME/shell/terhm.bash"
EOF
  # zsh: ZDOTDIR points here; each file sources the user's one from their ZDOTDIR
  for f in .zshenv .zprofile .zshrc .zlogin; do
    cat > "$d/zsh/$f" <<EOF
_terhm_zd=\$ZDOTDIR; ZDOTDIR=\$TERHM_ZDOTDIR
[[ -f \$ZDOTDIR/$f ]] && . \$ZDOTDIR/$f
TERHM_ZDOTDIR=\$ZDOTDIR; ZDOTDIR=\$_terhm_zd; unset _terhm_zd
EOF
  done
  cat >> "$d/zsh/.zshrc" <<'EOF'
path=("$TERHM_HOME/bin" $path)
. "$TERHM_HOME/shell/terhm.zsh"
EOF
  cat >> "$d/zsh/.zlogin" <<'EOF'
if [[ $TERHM_ZDOTDIR == "$HOME" ]]; then unset ZDOTDIR; else export ZDOTDIR=$TERHM_ZDOTDIR; fi
unset TERHM_ZDOTDIR
EOF
}

# Script run by the remote sh: unpack the bundle, check the tunnel, start the shell.
ssh_bootstrap() { # $1 = bundle id, $2 = remote port, $3 = bundle (tar.gz, base64)
  cat <<EOF
base="\${XDG_CACHE_HOME:-\$HOME/.cache}/terhm/ssh"
d="\$base/$1"
missing=""
for c in bash curl jq tar gzip base64; do command -v "\$c" >/dev/null 2>&1 || missing="\$missing \$c"; done
if [ -n "\$missing" ]; then
  printf 'terhm: missing on this host:%s. Ctrl+G is not available in this session.\n' "\$missing" >&2
  exec "\${SHELL:-/bin/sh}" -l
fi
if [ ! -f "\$d/.ok" ]; then
  if ! mkdir -p "\$d" 2>/dev/null || [ ! -w "\$d" ]; then
    d=\$(mktemp -d "\${TMPDIR:-/tmp}/terhm-ssh.XXXXXX")
  fi
  base64 -d <<'TERHM_BUNDLE' | tar xzf - -C "\$d" && touch "\$d/.ok"
$3
TERHM_BUNDLE
  # bundles of older terhm versions
  find "\$base" -mindepth 1 -maxdepth 1 -type d ! -name "$1" -mtime +30 -exec rm -rf {} + 2>/dev/null
fi
export TERHM_HOME="\$d" TERHM_CONFIG="\$d/config" TERHM_SSH_PORT=$2
if curl -fsS --max-time 3 "http://127.0.0.1:$2/health" >/dev/null 2>&1; then
  printf '\033[2mterhm: Ctrl+G uses the model on your local machine\033[0m\n' >&2
else
  printf 'terhm: cannot reach your local model through the tunnel (model not running locally, or port forwarding disabled on this server: AllowTcpForwarding)\n' >&2
fi
sh_path="\${SHELL:-/bin/sh}"
case "\${sh_path##*/}" in
  bash) exec "\$sh_path" --rcfile "\$d/bashrc" -i ;;
  zsh) export TERHM_ZDOTDIR="\${ZDOTDIR:-\$HOME}" ZDOTDIR="\$d/zsh"; exec "\$sh_path" -l ;;
  fish) exec "\$sh_path" -l -C "set -gx PATH '\$d/bin' \\\$PATH; source '\$d/shell/terhm.fish'" ;;
  *) printf 'terhm: %s is not supported, starting bash\n' "\$sh_path" >&2
     exec bash --rcfile "\$d/bashrc" -i ;;
esac
EOF
}

# ssh options that take an argument (from ssh(1))
SSH_ARG_OPTS="BbcDEeFIiJLlmOoPpQRSWw"

cmd_ssh() {
  local -a opts=() rest
  local a i ch passthru=0 host prompt shdir tmp id rport bundle script
  local orig=("$@")
  while [ $# -gt 0 ]; do
    a="$1"
    case "$a" in
      --) shift; break ;;
      -?*)
        opts+=("$a"); shift
        # option cluster like -vp: the first option that takes an argument ends it
        i=1
        while [ "$i" -lt "${#a}" ]; do
          ch="${a:$i:1}"
          case "$ch" in N|T|W|O|G|Q|V) passthru=1 ;; esac   # no interactive shell: plain ssh
          if [[ $SSH_ARG_OPTS == *"$ch"* ]]; then
            if [ "$i" -eq $(( ${#a} - 1 )) ] && [ $# -gt 0 ]; then opts+=("$1"); shift; fi
            break
          fi
          i=$((i + 1))
        done ;;
      *) break ;;
    esac
  done
  local ssh_bin="${TERHM_SSH_BIN:-ssh}"
  if [ $# -eq 0 ]; then exec "$ssh_bin" "${orig[@]}"; fi
  host="$1"; shift; rest=("$@")
  # a remote command or a non-interactive mode: nothing to add
  if [ "${#rest[@]}" -gt 0 ] || [ "$passthru" = 1 ]; then exec "$ssh_bin" "${orig[@]}"; fi

  prompt=$(find_prompt) || { err "prompts/system.txt not found (TERHM_HOME=$TERHM_HOME)"; return 2; }
  shdir=$(find_shell_dir) || { err "shell plugins not found (TERHM_HOME=$TERHM_HOME)"; return 2; }
  cmd_status || err "warning: the local model is not responding at $BASE_URL (Ctrl+G will fail until it is up)"

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/terhm-ssh.XXXXXX") || return 1
  mkdir -p "$tmp/bin" "$tmp/prompts" "$tmp/shell"
  cp "$SELF" "$tmp/bin/terhm"; chmod 755 "$tmp/bin/terhm"
  cp "$prompt" "$tmp/prompts/system.txt"
  cp "$shdir"/terhm.bash "$shdir"/terhm.zsh "$shdir"/terhm.fish "$tmp/shell/"
  # local settings (reasoning, sampling, dangerous regex...), then the tunnel
  { [ -f "$CONFIG_FILE" ] && grep -v '# terhm ssh$' "$CONFIG_FILE"
    printf 'TERHM_HOST=127.0.0.1 # terhm ssh\n'
    printf 'TERHM_PORT="$TERHM_SSH_PORT" # terhm ssh\n'
  } > "$tmp/config"
  ssh_write_rcfiles "$tmp"
  id="$TERHM_VERSION-$(cd "$tmp" && find . -type f | LC_ALL=C sort | xargs cat | sha256sum | cut -c1-12)"
  bundle=$(tar czf - -C "$tmp" --owner=0 --group=0 . | base64 -w0)
  rm -rf "$tmp"

  rport="${TERHM_SSH_REMOTE_PORT:-$((20000 + RANDOM % 40000))}"
  script=$(ssh_bootstrap "$id" "$rport" "$bundle" | base64 -w0)
  # Works whatever the remote login shell is (bash, zsh, fish, tcsh): only plain
  # words and one single-quoted string.
  exec "$ssh_bin" -t -R "$rport:$TERHM_HOST:$TERHM_PORT" "${opts[@]}" "$host" \
    "exec sh -c 'eval \"\$(echo $script | base64 -d)\"'"
}

usage() {
  cat <<USAGE
terhm $TERHM_VERSION
  terhm ask "request"       print the proposed command (never runs it)
  terhm fix [--status N] [--request "request"] -- "command"
                            propose a fix for a failed command
  terhm danger "command"    exit 0 if the command looks dangerous
  terhm context             print the context sent to the model from this directory
  terhm status              exit 0 if the server is up
  terhm doctor              check the installation
  terhm ssh [ssh options] host
                            ssh with Ctrl+G on the remote host, using the local model
Config: $CONFIG_FILE
USAGE
}

case "${1:-help}" in
  ask) shift; cmd_ask "$@" ;;
  fix) shift; cmd_fix "$@" ;;
  danger) shift; if [ "${1:-}" = "--" ]; then shift; fi; cmd_danger "${1:-}" ;;
  context) cmd_context ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  ssh) shift; cmd_ssh "$@" ;;
  version|--version|-v) echo "terhm $TERHM_VERSION" ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
